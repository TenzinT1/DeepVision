# DeepVision configuration — copy to `.env` and edit.
# Every variable is prefixed DEEPVISION_ and is OPTIONAL: the value shown after
# each name is the built-in default from deepvision/config.py, so an empty .env
# behaves identically to no .env at all.
#
# NOTE: user-editable settings (provider choices, API keys, OCR language, chunk
# sizes, report detail) live in the app's Settings screen / SQLite DB, NOT here.
# This file is deployment/environment config only. API keys are deliberately
# never read from the environment.

# ---- Paths (defaults derive from the repo root) ----
# DEEPVISION_PROJECT_ROOT=.
# DEEPVISION_DATA_DIR=./deepvision/data
# DEEPVISION_SQLITE_PATH=./deepvision/data/deepvision.db
# DEEPVISION_CHROMA_DIR=./deepvision/data/chroma

# ---- API server ----
# DEEPVISION_API_HOST=127.0.0.1
# DEEPVISION_API_PORT=8000
# DEEPVISION_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Provider strictness ----
# 1 (default) = local stages use the REAL adapters (Ollama, transformers,
# sentence-transformers). 0 = force the offline Echo/Null/Hash stubs, which is
# what scripts/smoke_check.py sets so it runs with no models installed.
# DEEPVISION_STRICT_PROVIDERS=1

# ---- Default provider modes (local-first; these seed AppSettings) ----
# DEEPVISION_DEFAULT_LLM_MODE=local
# DEEPVISION_DEFAULT_VISION_MODE=local
# DEEPVISION_DEFAULT_EMBEDDING_MODE=local

# ---- Local model identifiers ----
# DEEPVISION_OLLAMA_HOST=http://localhost:11434
# DEEPVISION_LOCAL_LLM_MODEL=llama3.1:8b
# Per-call socket timeout (seconds) for the local Ollama LLM. Must be > 0.
# Measured: a Standard report on llama3.1:8b = 12 calls, mean ~105s each; the
# old 120s ceiling tripped on 6 of them and silently fell back to the
# extractive draft.
# DEEPVISION_LOCAL_LLM_TIMEOUT=600.0
# DEEPVISION_LOCAL_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
# DEEPVISION_LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Must match the local embedding model's vector width; changing it invalidates
# the existing Chroma collection and requires a re-ingest.
# DEEPVISION_EMBEDDING_DIM=1024

# ---- API provider endpoints/models (used only when a stage is `api`) ----
# DEEPVISION_OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPVISION_ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPVISION_API_LLM_MODEL=claude-sonnet-5
# DEEPVISION_API_VISION_MODEL=claude-sonnet-5
# DEEPVISION_API_EMBEDDING_MODEL=text-embedding-3-large

# ---- Logging ----
# Read directly by deepvision/utils/logger.py (not by config.py), so these two
# must be real environment variables — a value here only applies if your shell
# or process manager exports the .env file.
# DEEPVISION_LOG_LEVEL=INFO
# DEEPVISION_LOG_JSON=0
